        <script>
$("#bars").click(function() {
    $(".smart-menu").toggleClass("vml");
    $(".mask").toggleClass("mask-active");
});
$(".mask").on("click", function() {
    $(".smart-menu").toggleClass("vml");
    $(".mask").toggleClass("mask-active");
});
</script>
<script>
    $(function(){
         var durl = $('.download');
         durl.remove();
         var sec = 7;
         var timer = setInterval(function() { 
             $(".fcounter span").text(sec--);
            if (sec == -1) {
                 $(".df-wrap").html(durl);
                 durl.fadeIn();
                 clearInterval(timer);
             } 
         }, 1000);   
    });

   

$(".menu-list li.drop-link ul").hide();
$(".menu-list > li.drop-link > a").on("click", function(e) {
    if (
        $(this)
        .parent()
        .has("ul")
    ) {
        e.preventDefault();
    }
    var speed = 300;
    if (!$(this).hasClass("active")) {
        $(".menu-list li.drop-link ul").slideUp(speed);
        $(".menu-list li.drop-link a").removeClass("active");
        $(".menu-list li.drop-link").addClass("dropup");
        $(this)
            .next("ul")
            .slideDown(speed);
        $(this).addClass("active");
    } else if ($(this).hasClass("active")) {
        $(this).removeClass("active");
        $(this)
            .next("ul")
            .slideUp(speed);
        $(".menu-list li.drop-link").removeClass("dropup");
    }
});
</script>
